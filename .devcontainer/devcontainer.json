{
  "name": "AI-CYBER secured Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "AI-CYBER local operations",
      "protocol": "http",
      "onAutoForward": "openBrowser",
      "visibility": "private"
    }
  },
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -e . pytest pytest-timeout",
  "postStartCommand": "python tools/codespace_start.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "remoteEnv": {
    "PYTHONFAULTHANDLER": "1"
  }
}
